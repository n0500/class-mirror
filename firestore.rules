rules_version = '2';
// مرآة الصف — قواعد حماية قاعدة البيانات
// المعلمات: إضافة تقييم جديد فقط (دون تسجيل دخول)، ولا يمكنهن القراءة أو التعديل أو الحذف.
// المالكة: كل صلاحيات الإدارة، مع إدارة رابط الدعوة وإيقاف الحسابات.
// حسابات الإدارة: قراءة التقييمات؛ والحذف للمالكة ومن تمنحها الصلاحية، مع توثيق كل حذف. تُنشئ كل واحدة حسابها بنفسها عبر رابط الدعوة،
// ويمكن للمالكة إيقاف أي حساب أو تغيير رابط الدعوة من لوحة المتابعة.
service cloud.firestore {
  match /databases/{database}/documents {

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isOwner() {
      return request.auth != null && myEmail() in [
        'nuha_0500@hotmail.com'
      ];
    }

    function isAdmin() {
      return request.auth != null
        && (isOwner() || (exists(/databases/$(database)/documents/admins/$(myEmail()))
            && get(/databases/$(database)/documents/admins/$(myEmail())).data.get('blocked', false) == false));
    }

    // حساب إدارة منحته المالكة صلاحية حذف التقييمات
    function canDeleteRatings() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(myEmail()))
        && get(/databases/$(database)/documents/admins/$(myEmail())).data.get('blocked', false) == false
        && get(/databases/$(database)/documents/admins/$(myEmail())).data.get('canDelete', false) == true;
    }

    function validClass(code) {
      return code in ['m1-1','m1-2','m1-3','m2-1','m2-2','m2-3','m3-1','m3-2','m3-3',
                      's1-1','s1-2','s1-3','s1-4','s2-1','s2-2','s2-3','s2-4','s3-1','s3-2','s3-3'];
    }

    match /observations/{id} {
      allow create: if request.resource.data.keys().hasOnly(['classCode','classroom','stage','subject','rating','note','teacher','createdAt'])
        && validClass(request.resource.data.classCode)
        && request.resource.data.classroom is string && request.resource.data.classroom.size() <= 40
        && request.resource.data.stage is string && request.resource.data.stage.size() <= 20
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 80
        && request.resource.data.rating in ['متميز', 'جيد', 'يحتاج متابعة']
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        // «يحتاج متابعة» تتطلب ملاحظة
        && (request.resource.data.rating != 'يحتاج متابعة' || request.resource.data.note.size() >= 3)
        // «أخرى» تتطلب اسم المعلمة
        && (!('teacher' in request.resource.data) || (request.resource.data.teacher is string && request.resource.data.teacher.size() <= 60))
        && (!request.resource.data.subject.matches('^أخرى.*') || ('teacher' in request.resource.data && request.resource.data.teacher.size() >= 2))
        && request.resource.data.createdAt == request.time;

      allow read: if isAdmin();
      // الحذف للمالكة ومن تمنحها الصلاحية، ولا يتم إلا مع توثيقه في سجل الحذف ضمن العملية نفسها
      allow delete: if (isOwner() || canDeleteRatings())
        && existsAfter(/databases/$(database)/documents/deletions/$(id));
      allow update: if false;
    }

    // سجل الحذف: يُنشأ مع الحذف فقط، ويطابق التقييم المحذوف، ولا يُعدَّل ولا يُحذف
    match /deletions/{id} {
      allow read: if isAdmin();
      allow create: if (isOwner() || canDeleteRatings())
        && !exists(/databases/$(database)/documents/deletions/$(id))
        && exists(/databases/$(database)/documents/observations/$(id))
        && !existsAfter(/databases/$(database)/documents/observations/$(id))
        && request.resource.data.keys().hasOnly(['by', 'at', 'reason', 'record'])
        && request.resource.data.by == myEmail()
        && request.resource.data.at == request.time
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 3 && request.resource.data.reason.size() <= 200
        && request.resource.data.record.classCode == get(/databases/$(database)/documents/observations/$(id)).data.get('classCode', '')
        && request.resource.data.record.subject == get(/databases/$(database)/documents/observations/$(id)).data.get('subject', '')
        && request.resource.data.record.rating == get(/databases/$(database)/documents/observations/$(id)).data.get('rating', '')
        && request.resource.data.record.note == get(/databases/$(database)/documents/observations/$(id)).data.get('note', '')
        && request.resource.data.record.createdAt == get(/databases/$(database)/documents/observations/$(id)).data.get('createdAt', null);
      allow update, delete: if false;
    }

    // رمز رابط الدعوة: للمالكة فقط
    match /settings/invite {
      allow get, create, update: if isOwner();
    }

    // حسابات الإدارة: التسجيل الذاتي برمز الدعوة الصحيح، والإيقاف للمالكة فقط
    match /admins/{email} {
      allow get: if request.auth != null && (isOwner() || myEmail() == email);
      allow list, update, delete: if isOwner();
      allow create: if isOwner() || (
        request.auth != null && myEmail() == email
        && request.resource.data.keys().hasOnly(['name', 'invite', 'addedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.addedAt == request.time
        && request.resource.data.invite == get(/databases/$(database)/documents/settings/invite).data.code
      );
    }

    // لوحة إنجازات الأسبوع للطالبات: أرقام إيجابية فقط (عدد الحصص المتميزة)، يقرؤها الجميع وتكتبها الإدارة
    match /public/weekly {
      allow get: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['weekStart', 'weekEnd', 'prevStart', 'classes', 'total', 'totalPrev', 'updatedAt'])
        && request.resource.data.classes is map
        && request.resource.data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
